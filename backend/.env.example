NODE_ENV=development
PORT=3000
# Whitelist origin được phép gọi API kèm cookie, phân tách bởi dấu phẩy (KHÔNG dùng "*")
CORS_ORIGIN=http://localhost:3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_erp?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# T051.08B — cờ Secure của cookie `refresh_token`, TÁCH KHỎI NODE_ENV: NODE_ENV trả lời "đây có
# phải production không", KHÔNG trả lời "kết nối này có TLS không". Bỏ trống (mặc định) giữ hành
# vi cũ = NODE_ENV==='production'; chỉ set tường minh khi topology triển khai KHÔNG khớp NODE_ENV
# (gói V1 đóng gói production trên HTTP localhost không TLS → AUTH_COOKIE_SECURE=false; một
# deployment HTTPS thật → AUTH_COOKIE_SECURE=true).
# AUTH_COOKIE_SECURE=false

SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Mặc định TẮT (T032.01E). Khi bật, GET /metrics vẫn chỉ Platform Admin truy cập được (không có
# truy cập ẩn danh) — xem metrics-enabled.guard.ts.
METRICS_ENABLED=false

# SMTP cho Forgot Password OTP (Prompt 014). Để trống ở dev → MailService log ra console thay vì gửi thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@pos-erp.local

# T053.04 — secret riêng cho Trial Signup (hash OTP, ký/xác minh signup proof token) — KHÔNG dùng
# chung với JWT_ACCESS_SECRET/JWT_REFRESH_SECRET. Bắt buộc ở production (đủ dài, không phải
# placeholder — xem env.validation.ts assertProductionSignupSecretSet), tùy chọn ở dev/test.
SIGNUP_SECRET=change-me-signup-secret

# T043.05 — kích hoạt hành vi Product đã được duyệt ở SPEC-PRODUCT-001 (Optimistic Lock,
# Product Type change guard PRODUCT_008, Archive-blocks-active-variant guard PRODUCT_012).
# Dev-only, không nằm trong env.validation.ts. Đặt "false" để tái lập hành vi cũ (rollback).
PRODUCT_REFACTOR_ENABLED=true

# T051.03 — Backup/Restore (docs/release/BACKUP-RESTORE-RUNBOOK.md). Tất cả đều optional, có
# default hợp lý — chỉ cần set nếu muốn khác mặc định.
# BACKUP_DIR=./backups
# BACKUP_MODE=docker-compose
# BACKUP_RETENTION_COUNT=7
# DOCKER_COMPOSE_SERVICE=postgres
# BACKUP_TIMEOUT_MS=600000
# RESTORE_TIMEOUT_MS=900000

# T051.04 — Bootstrap Organization/Branch/Administrator ĐẦU TIÊN của deployment (chạy 1 lần bởi
# service `bring-up` trong docker-compose.yml — xem docs/release/WINDOWS-DEPLOYMENT-RUNBOOK.md).
# CHỈ 2 biến EMAIL/PASSWORD bắt buộc — phần còn lại có default, đổi lại nếu muốn tên tổ chức khác.
FIRST_ADMIN_EMAIL=admin@pos-erp.local
FIRST_ADMIN_PASSWORD=change-me-strong-admin-password
# FIRST_ADMIN_ORG_CODE=MAIN
# FIRST_ADMIN_ORG_NAME=Cửa hàng của tôi
# FIRST_ADMIN_ORG_SLUG=cua-hang-cua-toi
# FIRST_ADMIN_BRANCH_CODE=MAIN
# FIRST_ADMIN_BRANCH_NAME=Chi nhánh chính
# FIRST_ADMIN_USERNAME=admin
# FIRST_ADMIN_FULL_NAME=
