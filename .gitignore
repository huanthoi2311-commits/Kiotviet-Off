# Dependencies (root-level tooling: commitlint/husky/commit-and-tag-version)
/node_modules

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea

# Logs
*.log
logs/

# Env (mỗi package đã có .gitignore riêng loại trừ .env, giữ dòng này để chắc chắn ở gốc)
.env
.env.local
!.env.example

# Playwright screenshot tooling output (tools/playwright/) — tạm thời, không phải artifact release
/artifacts/screenshots/*
!/artifacts/screenshots/.gitkeep
