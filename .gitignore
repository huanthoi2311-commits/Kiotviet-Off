# Dependencies (root-level tooling: commitlint/husky/commit-and-tag-version)
/node_modules

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea

# Logs
*.log
logs/

# Env (mỗi package đã có .gitignore riêng loại trừ .env, giữ dòng này để chắc chắn ở gốc)
.env
.env.local
!.env.example

# Backup dumps chạy thủ công ở gốc repo (khác backend/backups/ đã có backend/.gitignore riêng) —
# KHÔNG BAO GIỜ commit artifact backup (chứa toàn bộ dữ liệu nghiệp vụ, coi như dữ liệu nhạy cảm).
/backups/
*.dump

# Playwright screenshot tooling output (tools/playwright/) — tạm thời, không phải artifact release
/artifacts/screenshots/*
!/artifacts/screenshots/.gitkeep
